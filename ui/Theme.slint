export global Theme {
    // Paleta de Cores Apple Music (macOS)
    out property <color> accent: #FA2D55;
    out property <color> accent-hover: #e02449;
    out property <color> background-base: #161618;
    out property <color> background-sidebar: #121214;
    out property <color> background-player: #1c1c1f;
    out property <color> background-card: #18181c;

    // Superfícies e Elevações Translúcidas (macOS Glass)
    out property <color> surface-hover: #ffffff0a;
    out property <color> surface-active: #ffffff18;
    out property <color> surface-raised: #ffffff14;
    out property <color> surface-card: #ffffff0e;
    out property <color> border-subtle: #ffffff10;
    out property <color> border-medium: #ffffff20;
    out property <color> border-focus: #ffffff35;
    out property <color> accent-surface: #FA2D5518;
    out property <color> accent-border: #FA2D5533;

    // Tipografia Apple
    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #86868b;
    out property <color> text-tertiary: #636366;
    out property <string> default-font-family: "'SF Pro Display', 'Segoe UI Variable Display', -apple-system, sans-serif";

    // Raios de Borda Oficiais Apple
    out property <length> radius-card: 14px;
    out property <length> radius-cover: 12px;
    out property <length> radius-control: 8px;
    out property <length> radius-search: 16px;
    out property <length> radius-pill: 16px;
    out property <length> radius-circle: 9999px;
}
